# ==============================================================================
# KAAZE Storefront — Environment Configuration Template
# Copy this file to .env.local and populate with your verified project keys.
# Never commit .env.local or real secret keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Authentication & Database Configuration
# ------------------------------------------------------------------------------
# Project URL found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://smnvrcfkxirlbtompqzc.supabase.co
# Publishable Anon API Key (safe for browser usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_H2un9c9zs8ujLohVXCGhgQ_q48d1YFi
# Optional: Service Role Key (SERVER-SIDE ONLY - NEVER prefix with NEXT_PUBLIC_)
# Used exclusively in secure server-side API routes / administrative webhooks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# Canonical application URL used for email auth redirects and callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Shopify Storefront & Customer Orders Configuration
# ------------------------------------------------------------------------------
# Your Shopify store domain (e.g., kaaze-edtn.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com

# Shopify Storefront Access Token (public read-only token for catalog/cart)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-shopify-storefront-access-token

# Shopify Admin API Access Token (SERVER-SIDE ONLY - NEVER prefix with NEXT_PUBLIC_)
# Used in server-side API routes (/api/orders) to look up authenticated customer orders
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_your_admin_api_access_token_server_only
